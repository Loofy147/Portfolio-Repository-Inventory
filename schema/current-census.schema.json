{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Loofy147/Portfolio-Repository-Inventory/schema/current-census.schema.json",
  "title":"CurrentCensusOverlayV0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","snapshot_id","observed_on","scope","search_method","installed_search_method","reconciliation","repositories"],
  "properties":{
    "schema_version":{"type":"string","const":"0.1.0"},
    "snapshot_id":{"type":"string"},
    "observed_on":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "scope":{"type":"string"},
    "search_method":{"type":"object","additionalProperties":false,"required":["query","pages","counts","total"],"properties":{
      "query":{"type":"string"},
      "pages":{"type":"array","items":{"type":"integer","minimum":1}},
      "counts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["page","count"],"properties":{"page":{"type":"integer","minimum":1},"count":{"type":"integer","minimum":0}}}},
      "total":{"type":"integer","minimum":0}
    }},
    "installed_search_method":{"type":"object","additionalProperties":false,"required":["query","pages","counts","total"],"properties":{
      "query":{"type":"string"},
      "pages":{"type":"array","items":{"type":"integer","minimum":1}},
      "counts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["page","count"],"properties":{"page":{"type":"integer","minimum":1},"count":{"type":"integer","minimum":0}}}},
      "total":{"type":"integer","minimum":0}
    }},
    "reconciliation":{"type":"object","additionalProperties":false,"required":["exact_set_match","search_only","installed_only","prior_inventory_count","prior_inventory_overlap","newly_observed_count"],"properties":{
      "exact_set_match":{"type":"boolean"},
      "search_only":{"type":"array","items":{"type":"string"}},
      "installed_only":{"type":"array","items":{"type":"string"}},
      "prior_inventory_count":{"type":"integer","minimum":0},
      "prior_inventory_overlap":{"type":"integer","minimum":0},
      "newly_observed_count":{"type":"integer","minimum":0}
    }},
    "repositories":{"type":"array","uniqueItems":true,"items":{
      "type":"object","additionalProperties":false,"required":["repository_full_name","identity"],"properties":{
        "repository_full_name":{"type":"string","pattern":"^[^/]+/[^/]+$"},
        "identity":{"type":"object","additionalProperties":false,"required":["name","owner","visibility","default_branch","archived","size_kb"],"properties":{
          "name":{"type":"string"},"owner":{"type":"string"},"visibility":{"type":"string","enum":["public","private","internal","unknown"]},
          "default_branch":{"type":["string","null"]},"archived":{"type":["boolean","null"]},"size_kb":{"type":["integer","null"],"minimum":0}
        }}
      }
    }}
  }
}
