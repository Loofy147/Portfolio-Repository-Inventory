{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Loofy147/Portfolio-Repository-Inventory/schema/repository-review.schema.json",
  "title": "RepositoryReviewRecordV0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "observation",
    "state",
    "evidence",
    "unknowns"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.2.0"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "full_name",
        "default_branch"
      ],
      "properties": {
        "full_name": {
          "type": "string"
        },
        "id": {
          "type": [
            "string",
            "integer"
          ]
        },
        "url": {
          "type": "string"
        },
        "default_branch": {
          "type": "string"
        },
        "visibility": {
          "type": "string"
        },
        "archived": {
          "type": "boolean"
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observed_at",
        "ref",
        "depth"
      ],
      "properties": {
        "observed_at": {
          "type": "string"
        },
        "ref": {
          "type": "string"
        },
        "commit": {
          "type": "string"
        },
        "branches_inspected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "surfaces_inspected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "depth": {
          "type": "string",
          "enum": [
            "D0",
            "D1",
            "D2",
            "D3",
            "D4"
          ]
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "project_status"
      ],
      "properties": {
        "project_status": {
          "type": "string",
          "enum": [
            "CURRENT",
            "DEFAULT-BRANCH",
            "RESEARCH-FRONTIER",
            "HISTORICAL",
            "UNMERGED",
            "UNKNOWN"
          ]
        },
        "interpretation": {
          "type": "string"
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "class",
          "statement"
        ],
        "properties": {
          "class": {
            "type": "string",
            "enum": [
              "OBSERVED",
              "DERIVED",
              "INFERRED",
              "USER_REPORTED",
              "UNKNOWN",
              "CONTRADICTED"
            ]
          },
          "claim_status": {
            "type": "string",
            "enum": [
              "ESTABLISHED",
              "EXPERIMENTALLY_SUPPORTED",
              "USER_REPORTED",
              "INFERENCE",
              "HYPOTHESIS",
              "CONTRADICTED",
              "UNKNOWN",
              "OPEN"
            ]
          },
          "statement": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "limits": {
            "type": "string"
          }
        }
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unknowns": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "contradictions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target",
          "relation",
          "status"
        ],
        "properties": {
          "target": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tests_inspected": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tests_executed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reproducibility": {
          "type": "string"
        },
        "falsifiers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "next_test": {
      "type": "string"
    }
  }
}