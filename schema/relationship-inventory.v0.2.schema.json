{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Loofy147/Portfolio-Repository-Inventory/schema/relationship-inventory.v0.2.schema.json",
  "title":"PortfolioRelationshipInventoryV0.2",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","migrated_from","migrated_on","relationships"],
  "properties":{
    "schema_version":{"type":"string","const":"0.2.0"},
    "migrated_from":{"type":"string","const":"0.1.0"},
    "migrated_on":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "relationships":{
      "type":"array",
      "items":{
        "type":"object",
        "additionalProperties":false,
        "required":["schema_version","source","target","relation","status","evidence_refs","status_basis","next_test"],
        "properties":{
          "schema_version":{"type":"string","const":"0.2.0"},
          "source":{"type":"string"},
          "target":{"type":"string"},
          "relation":{"type":"string","enum":["HISTORICAL_REFERENCE","POSSIBLE_LINEAGE","ESTABLISHED_LINEAGE","SHARED_PRIMITIVE_CANDIDATE","DUPLICATE_CANDIDATE","INDEPENDENT_SIMILARITY","SUCCESSOR_CANDIDATE","DEPENDENCY","SAME_PROJECT","SAME_IDEA","SUCCESSOR","PREDECESSOR","FORK","COMPONENT_SOURCE","RESEARCH_SOURCE","UNKNOWN"]},
          "status":{"type":"string","enum":["OBSERVED","DERIVED","INFERRED","USER_REPORTED","UNKNOWN","CONTRADICTED","OPEN"]},
          "confidence":{"type":"string","enum":["high","medium","low","unknown"]},
          "evidence_refs":{"type":"array","items":{"type":"string"}},
          "notes":{"type":"string"},
          "status_basis":{"type":"string"},
          "next_test":{"type":"string"}
        }
      }
    }
  }
}
