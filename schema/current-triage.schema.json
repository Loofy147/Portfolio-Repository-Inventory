{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Loofy147/Portfolio-Repository-Inventory/schema/current-triage.schema.json",
  "title":"CurrentStructuralTriageV0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","observed_on","snapshot_id","records"],
  "properties":{
    "schema_version":{"type":"string","const":"0.1.0"},
    "observed_on":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "snapshot_id":{"type":"string"},
    "records":{
      "type":"array","uniqueItems":true,
      "items":{
        "type":"object","additionalProperties":false,
        "required":["repository_full_name","ref","commit","provenance","observations","triage","epistemic","evidence_refs"],
        "properties":{
          "repository_full_name":{"type":"string","pattern":"^[^/]+/[^/]+$"},
          "ref":{"type":"string"},
          "commit":{"type":"string","pattern":"^[0-9a-f]{7,40}$"},
          "provenance":{
            "type":"object","additionalProperties":false,
            "required":["fork","status"],
            "properties":{
              "fork":{"type":"boolean"},
              "parent":{"type":["string","null"]},
              "source":{"type":["string","null"]},
              "status":{"type":"string","enum":["first_party_candidate","external_fork","provenance_unknown"]}
            }
          },
          "observations":{
            "type":"object","additionalProperties":false,
            "required":["visibility","archived","size_kb","root_signals","tests","ci"],
            "properties":{
              "visibility":{"type":"string"},
              "archived":{"type":["boolean","null"]},
              "size_kb":{"type":["integer","null"],"minimum":0},
              "root_signals":{"type":"array","items":{"type":"string"}},
              "tests":{"type":"string","enum":["present","absent_verified","unknown"]},
              "ci":{"type":"string","enum":["present","absent_verified","unknown"]}
            }
          },
          "triage":{
            "type":"object","additionalProperties":false,
            "required":["maturity_signal","review_priority","route","notes"],
            "properties":{
              "maturity_signal":{"type":"string","enum":["empty","minimal","prototype_signal","substantial","research_baseline_signal","production_candidate_signal","external_reference","killed_research_artifact","unknown"]},
              "review_priority":{"type":"string","enum":["low","medium","high","critical"]},
              "route":{"type":"string","enum":["DEEP_REVIEW","LINEAGE_REVIEW","REFERENCE_ONLY","HOLD"]},
              "notes":{"type":"string"}
            }
          },
          "epistemic":{
            "type":"object","additionalProperties":false,
            "required":["status","assessed_at"],
            "properties":{
              "status":{"type":"string","enum":["observed","derived","inferred","unknown"]},
              "assessed_at":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}
            }
          },
          "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}}
        }
      }
    }
  }
}
