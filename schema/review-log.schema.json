{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Loofy147/Portfolio-Repository-Inventory/schema/review-log.schema.json",
  "title":"PortfolioReviewLogV0.2",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","review_date","last_updated","purpose","depth_levels","records"],
  "properties":{
    "schema_version":{"type":"string","const":"0.2.0"},
    "review_date":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "last_updated":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
    "purpose":{"type":"string"},
    "depth_levels":{"type":"object","additionalProperties":{"type":"string"}},
    "records":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["repository","depth","evidence","current_focus","next"],
        "properties":{
          "repository":{"type":"string"},
          "depth":{"type":"string","enum":["D0","D1","D2","D3","D4"]},
          "evidence":{"type":"array","items":{"type":"string"}},
          "current_focus":{"type":"string"},
          "next":{"type":"string"},
          "observed_on":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
          "ref":{"type":"string","minLength":1},
          "commit":{"type":"string","pattern":"^[0-9a-f]{7,40}$"},
          "surfaces_inspected":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
          "tests_executed":{"type":"array","items":{"type":"string"}},
          "artifacts":{"type":"array","items":{"type":"string"}},
          "verification_notes":{"type":"string"}
        },
        "allOf":[{"if":{"properties":{"depth":{"const":"D4"}}},"then":{"required":["observed_on","ref","commit","surfaces_inspected","tests_executed","artifacts","verification_notes"]}}]
      }
    }
  }
}
