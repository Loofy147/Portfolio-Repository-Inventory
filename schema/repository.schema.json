{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Loofy147/Portfolio-Repository-Inventory/schema/repository.schema.json",
  "title":"RepositoryInventoryRecord",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","repository_full_name","identity","epistemic"],
  "properties":{
    "schema_version":{"type":"string","const":"0.1.0"},
    "repository_full_name":{"type":"string","pattern":"^[^/]+/[^/]+$"},
    "identity":{"type":"object","additionalProperties":false,"required":["name","owner","visibility","default_branch"],"properties":{
      "name":{"type":"string"},"owner":{"type":"string"},
      "visibility":{"type":"string","enum":["public","private","internal","unknown"]},
      "default_branch":{"type":["string","null"]},"archived":{"type":["boolean","null"]},
      "description":{"type":["string","null"]},"language":{"type":["string","null"]},
      "size_kb":{"type":["integer","null"],"minimum":0},
      "created_at":{"type":["string","null"]},"updated_at":{"type":["string","null"]},"pushed_at":{"type":["string","null"]}
    }},
    "technical":{"type":"object","additionalProperties":false,"properties":{
      "languages":{"type":"array","items":{"type":"string"}},
      "frameworks":{"type":"array","items":{"type":"string"}},
      "tests":{"type":"string","enum":["present","absent_verified","unknown"]},
      "ci":{"type":"string","enum":["present","absent_verified","unknown"]},
      "deployment":{"type":"string","enum":["present","absent_verified","unknown"]}
    }},
    "substance":{"type":"object","additionalProperties":false,"properties":{
      "purpose":{"type":["string","null"]},
      "maturity":{"type":"string","enum":["idea","prototype","poc","mvp","production_candidate","production","research_artifact","unknown"]},
      "research_value":{"type":"string","enum":["high","medium","low","unknown"]},
      "product_value":{"type":"string","enum":["high","medium","low","unknown"]},
      "reusable_components":{"type":"array","items":{"type":"string"}}
    }},
    "decision":{"type":"object","additionalProperties":false,"required":["status"],"properties":{
      "status":{"type":"string","enum":["unassessed","keep","merge","extract","freeze","archive"]},
      "target_repository":{"type":["string","null"]},"confidence":{"type":"string","enum":["high","medium","low","unknown"]},
      "rationale":{"type":["string","null"]}
    }},
    "relationships":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["type","target"],"properties":{
      "type":{"type":"string","enum":["same_project","same_idea","successor","predecessor","fork","duplicate_candidate","dependency","component_source","research_source","unknown"]},
      "target":{"type":"string"},"confidence":{"type":"string","enum":["high","medium","low","unknown"]},"evidence_ref":{"type":["string","null"]}
    }}},
    "epistemic":{"type":"object","additionalProperties":false,"required":["fact_status"],"properties":{
      "fact_status":{"type":"string","enum":["observed","derived","inferred","user_reported","unknown"]},
      "snapshot_id":{"type":["string","null"]},"assessed_at":{"type":["string","null"]}
    }}
  }
}