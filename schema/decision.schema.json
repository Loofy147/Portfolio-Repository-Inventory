{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Loofy147/Portfolio-Repository-Inventory/schema/decision.schema.json",
  "title":"PortfolioDecisionV0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","decisions"],
  "properties":{
    "schema_version":{"type":"string","const":"0.1.0"},
    "decisions":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["decision_id","decision_type","status","decided_on","basis","subject","evidence_refs"],
        "properties":{
          "decision_id":{"type":"string"},
          "decision_type":{"type":"string","enum":["current_target","core_working_set","repository_disposition"]},
          "status":{"type":"string","enum":["active","superseded"]},
          "decided_on":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
          "basis":{"type":"string","enum":["owner_selected","evidence_review","revalidation"]},
          "subject":{"oneOf":[
            {"type":"string","pattern":"^[^/]+/[^/]+$"},
            {"type":"array","uniqueItems":true,"minItems":1,"items":{"type":"string","pattern":"^[^/]+/[^/]+$"}}
          ]},
          "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
          "supersedes":{"type":"array","items":{"type":"string"}},
          "notes":{"type":"string"}
        }
      }
    }
  }
}
