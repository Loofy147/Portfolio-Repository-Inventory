{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://github.com/Loofy147/Portfolio-Repository-Inventory/schema/census-snapshot.schema.json",
  "title":"PortfolioCensusSnapshotsV0.1",
  "type":"object",
  "additionalProperties":false,
  "required":["schema_version","snapshots"],
  "properties":{
    "schema_version":{"type":"string","const":"0.1.0"},
    "snapshots":{
      "type":"array",
      "items":{
        "type":"object","additionalProperties":false,
        "required":["snapshot_id","observed_on","method","scope","observed_count","completeness","canonicality","evidence_refs","notes"],
        "properties":{
          "snapshot_id":{"type":"string"},
          "observed_on":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"},
          "method":{"type":"string"},
          "scope":{"type":"string"},
          "observed_count":{"type":"integer","minimum":0},
          "completeness":{"type":"string","enum":["complete","historical_snapshot","bounded_partial","unknown"]},
          "canonicality":{"type":"string","enum":["canonical_historical","operational_observation","not_canonical"]},
          "pagination":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["offset","count"],"properties":{"offset":{"type":"integer","minimum":0},"count":{"type":"integer","minimum":0}}}},
          "evidence_refs":{"type":"array","minItems":1,"items":{"type":"string"}},
          "notes":{"type":"string"}
        }
      }
    }
  }
}
